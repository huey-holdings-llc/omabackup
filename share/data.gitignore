# Belt-and-braces. The allowlist already governs what is copied in, but if any
# of these ever appear in this tree it is a bug -- fail closed, don't commit.
.staging/
# The marker is written atomically (mktemp beside it, then mv), so an
# interrupted setup leaves .omabackup.XXXXXX behind. The marker itself is
# tracked; only its scratch files match this.
.omabackup.*
*.bak.*
id_*
!id_*.pub
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.ovpn
*.jks
*.asc
.env
.env.*
.netrc
.git-credentials
.npmrc
.pypirc
hosts.yml
.credentials.json
credentials
Cookies*
*.sqlite
*.sqlite-wal
*.sqlite-shm
.lock
manifests/.last-run
