# Paths under $HOME that are deliberately not backed up, one per line,
# relative to $HOME. A path here is silenced in drift reports without being
# copied into the data repo.
#
# Format: <path>   # YYYY-MM-DD reason
#   path        ignores exactly that path (also treated as a glob)
#   path/**     ignores the whole subtree; use only when nothing under it
#               will ever matter
# Every ignore needs a dated reason: a line with no comment is a decision
# nobody can audit later.

# --- $HOME/.cache ---
.cache/**                        # 2026-08-23 application cache, never config

# --- $HOME/.local/state: Omarchy ---
.local/state/omarchy/migrations/**      # 2026-08-23 migration markers, regenerated on upgrade
.local/state/omarchy/notifications/**   # 2026-08-23 transient notification history
.local/state/omarchy/notifications.json # 2026-08-23 transient
.local/state/omarchy/done/**            # 2026-08-23 first-run completion markers
.local/state/omarchy/windows/**         # 2026-08-23 transient window state
.local/state/omarchy/indicators/**      # 2026-08-23 empty or transient
.local/state/omarchy/clipboard-history.json  # 2026-08-23 SECRET: pasted credentials can land here
.local/state/omarchy/clipboard-images/**     # 2026-08-23 SECRET: pasted screenshots
.local/state/omarchy/*.log              # 2026-08-23 logs
.local/state/omarchy/agents/**          # 2026-08-23 per-agent token usage counters, transient
.local/state/omarchy/auto-workspace/last_boot_id  # 2026-08-24 per-boot id; config.json in the same dir is allowlisted, so not a /** ignore
.local/state/omarchy/current/**         # 2026-08-23 rotation frames; curation lives in themebook.json instead
.local/state/omarchy-display-manager/pending.json  # 2026-08-23 transient; profiles.json is allowlisted
.local/state/omarchy-notification-center/**  # 2026-08-23 notification archive, lock and seen state

# --- $HOME/.local/state: Arch-base tools ---
.local/state/wireplumber/**      # 2026-08-23 audio runtime state
.local/state/gh/**               # 2026-08-23 device id, regenerated on next auth

# --- $HOME/.local/share: Omarchy and Arch-base tools ---
.local/share/hyprland/**         # 2026-08-23 runtime state
.local/share/sddm/**             # 2026-08-23 display-manager state
.local/share/systemd/**          # 2026-08-23 timer stamp files, runtime state
.local/share/icons/**            # 2026-08-23 installed by packages, regenerable
.local/share/mime/**             # 2026-08-23 generated cache; mime/packages is allowlisted separately
.local/share/keyrings/**         # 2026-08-23 SECRET: keyring database
.local/share/recently-used.xbel  # 2026-08-23 transient recently-used list
.local/share/mimeapps.list       # 2026-08-23 deprecated location; .config/mimeapps.list is allowlisted
.local/share/applications/mimeinfo.cache  # 2026-08-23 generated by desktop-file-utils
