#!/usr/bin/env bash
# omabackup: back up your Omarchy config to a private git repo every day, and
# say what is not being backed up. All logic lives here and in lib/; the shell
# plugin (Panel.qml, Service.qml) is a view over status.json.
#
# Usage: omabackup <verb> [args] [--json]   (omabackup help lists the verbs)
set -euo pipefail
umask 077

command -v jq >/dev/null 2>&1 || { echo "omabackup: jq is required (pacman -S jq)" >&2; exit 1; }
SELF="$(readlink -f "$0")"
PLUGIN_DIR="$(dirname "$(dirname "$SELF")")"
VERSION=$(jq -r '.version // "0"' "$PLUGIN_DIR/manifest.json" 2>/dev/null || echo 0)
PLUGIN_ID="io.github.huey-holdings-llc.omabackup"
export PLUGIN_DIR VERSION PLUGIN_ID

# --json may appear anywhere; strip it and remember.
JSON=0; ARGS=()
for a in "$@"; do
  case "$a" in --json) JSON=1 ;; *) ARGS+=("$a") ;; esac
done
export JSON

for f in "$PLUGIN_DIR"/lib/*.sh; do
  # shellcheck source=/dev/null
  . "$f"
done

usage() {
  cat <<'EOF'
omabackup <verb> [args] [--json]

  setup [--data-repo DIR] [--remote URL] [--create-private] [--import DIR]
        [--trust-remote] [--no-timers] [--yes]     first-run wizard
  setup check                                       doctor
  setup --remove [--yes]                            remove units, symlink, config
  snapshot [--dry-run] [--no-push]                  the daily pipeline
  drift                                             report unbacked config
  status                                            health (writes status.json)
  allow PATH | ignore PATH [REASON]                 triage a drift entry
  resolve-gone PATH remove|optional                 fix a vanished entry
  push [--confirm]                                  push commits (lists need --confirm)
  lint [--no-walk]                                  list hygiene
  restore --configs|--etc|--packages|--plugins|--services|--all [--apply]
  verify                                            restore fidelity check
  health                                            login check (silent when ok)
  timer pause|resume|status|run
  self-test [--real]
  open [--remote]                                   a terminal in the data repo, or its page on GitHub
  version
Every verb accepts --json. Exit 0 ran, 1 refused or unhealthy, 2 usage.
EOF
}

main() {
  local verb=${ARGS[0]:-help}
  [[ ${#ARGS[@]} -gt 0 ]] && ARGS=("${ARGS[@]:1}")
  case "$verb" in
    help|-h|--help|version|setup) ;;
    # status and health must still report SOMETHING with no config at all --
    # the dispatcher skips config_load for them here and cmd_status/cmd_health
    # never run in that case; a not-configured object/hint is emitted below.
    status)
      if config_exists; then
        config_load
      else
        # status.json is the widget's only view of the world -- write it here
        # too, or a stale "healthy" file from a previous config survives a
        # config being removed and the widget never learns.
        local j; j=$(health_not_configured_json)
        state_write_status "$j"
        if [[ $JSON == 1 ]]; then
          printf '%s\n' "$j"
        else
          printf '\033[1;33m[omabackup] not configured -- run: omabackup setup\033[0m\n'
        fi
        return 0
      fi ;;
    health)
      if config_exists; then
        config_load
      else
        # Same shared object status uses, so the two never drift apart, with
        # ok:false in front of it: --json must get one JSON object here too,
        # not a coloured line it cannot parse.
        local hj; hj=$(health_not_configured_json)
        if [[ $JSON == 1 ]]; then
          jq -c '{ok:false} + . + {problems: (.problems + ["not configured; run: omabackup setup"])}' <<<"$hj"
        else
          printf '\033[1;31m[omabackup] not configured -- run: omabackup setup\033[0m\n'
        fi
        exit 1
      fi ;;
    # notify-failure is the unit's OnFailure= hook: the one verb whose whole
    # job is to speak up when something else has already gone wrong. A missing
    # or unparsable config is exactly such a failure, and requiring config_load
    # here meant the broken config silenced the notification about itself --
    # the snapshot unit failed, its ExecStopPost died on the same config, and
    # the user's only signal was a red line in a journal nobody reads.
    # So: read the config best-effort, for the one value notify() consults.
    # config_load die()s, and die exits the process rather than returning, so
    # it runs in a subshell and only its answer is carried back. notify()
    # already defaults CFG_NOTIFY to true, which is the fail-loud direction.
    notify-failure)
      if config_exists; then
        local nv; nv=$( (config_load >/dev/null 2>&1 && printf '%s' "${CFG_NOTIFY:-true}") || true )
        if [[ "$nv" == false ]]; then CFG_NOTIFY=false; fi
      fi ;;
    snapshot|drift|allow|ignore|resolve-gone|push|lint|restore|verify|timer|self-test|open) config_load ;;
    *) usage_die "unknown verb '$verb'" ;;
  esac
  case "$verb" in
    help|-h|--help) if [[ $JSON == 1 ]]; then jq -cn --arg u "$(usage)" '{ok:true, usage:$u}'; else usage; fi ;;
    version) if [[ $JSON == 1 ]]; then jq -cn --arg v "$VERSION" '{version:$v}'; else echo "$VERSION"; fi ;;
    setup|snapshot|drift|status|allow|ignore|resolve-gone|push|lint|restore|verify|health|timer|self-test|open|notify-failure)
      local fn="cmd_${verb//-/_}"
      declare -F "$fn" >/dev/null || die "verb '$verb' is not implemented yet"
      "$fn" "${ARGS[@]}" ;;
    *) usage_die "unknown verb '$verb'" ;;
  esac
}
main
