#!/usr/bin/env bash
# omabackup: back up your Omarchy config to a private git repo every day, and
# say what is not being backed up. All logic lives here and in lib/; the shell
# plugin (Panel.qml, Service.qml) is a view over status.json.
#
# Usage: omabackup <verb> [args] [--json]   (omabackup help lists the verbs)
set -euo pipefail
umask 077

command -v jq >/dev/null 2>&1 || { echo "omabackup: jq is required (pacman -S jq)" >&2; exit 1; }
SELF="$(readlink -f "$0")"
PLUGIN_DIR="$(dirname "$(dirname "$SELF")")"
VERSION=$(jq -r '.version // "0"' "$PLUGIN_DIR/manifest.json" 2>/dev/null || echo 0)
PLUGIN_ID="io.github.huey-holdings-llc.omabackup"
export PLUGIN_DIR VERSION PLUGIN_ID

# --json may appear anywhere; strip it and remember.
JSON=0; ARGS=()
for a in "$@"; do
  case "$a" in --json) JSON=1 ;; *) ARGS+=("$a") ;; esac
done
export JSON

for f in "$PLUGIN_DIR"/lib/*.sh; do
  # shellcheck source=/dev/null
  . "$f"
done

# VERB_TABLE: the one place each verb's name, its argument line, its one-line
# summary and its config-load mode live. usage() renders the whole table,
# `omabackup <verb> --help` renders that verb's rows alone, and the two case
# statements in main() read the load mode from here, so none of them can drift
# apart. Four fields per row, in this order:
#   names    the verbs this row documents, space separated (one row covers two)
#   sig      the signature as printed; a newline starts a continuation line
#   summary  the description, or "" for a row whose signature says it all
#   load     what the verb needs from the config before it runs:
#              none     it runs without one (setup writes it; version reads none)
#              plain    config_load "$verb", the ordinary case
#              special  it has to report something with no config at all, so
#                       main() spells that arm out by name below
# notify-failure is deliberately absent, as it was from the old text: it is the
# units' OnFailure= hook, not something a person types, and leaving it out of
# the table is also what keeps `omabackup notify-failure --help` reaching its
# own usage line instead of a row rendered from here.
VERB_TABLE=(
  "setup" "setup [--data-repo DIR] [--remote URL] [--create-private] [--import DIR]
[--trust-remote] [--no-timers] [--yes]" "first-run wizard" "none"
  "setup" "setup check" "doctor" "none"
  "setup" "setup --remove [--yes]" "remove units, symlink, config" "none"
  "snapshot" "snapshot [--dry-run] [--no-push] [--accept-allowlist]" "the daily pipeline" "plain"
  "drift" "drift" "report unbacked config" "plain"
  "status" "status" "health (writes status.json)" "special"
  "allow ignore" "allow PATH | ignore PATH [REASON]" "triage a drift entry" "plain"
  "resolve-gone" "resolve-gone PATH remove|optional" "fix a vanished entry" "plain"
  "push" "push [--confirm [SIG]]" "push commits (repo edits need --confirm)" "plain"
  "lint" "lint [--no-walk]" "list hygiene" "plain"
  "restore" "restore --configs|--etc|--packages|--plugins|--services|--all [--apply]" "" "plain"
  "verify" "verify" "restore fidelity check" "plain"
  "health" "health" "login check (silent when ok)" "special"
  "timer" "timer pause|resume|status|run" "" "plain"
  "self-test" "self-test [--real]" "" "plain"
  "open" "open [--report|--remote]" "a terminal in the data repo, the drift report, or its page on GitHub" "plain"
  "version" "version" "" "none"
)
# VERB_FIELDS: how many fields one VERB_TABLE row occupies. Every walk below
# steps by it, so adding a field is one edit here and one per row.
VERB_FIELDS=4
VERB_FOOTER="Every verb accepts --json. Exit 0 ran, 1 refused or unhealthy, 2 usage."

# verb_row SIG SUMMARY: render one table row. The signature's first line is
# indented two and its continuation lines eight, under the verb name; the
# summary hangs off the last line at one fixed column.
verb_row() {
  local sig=$1 sum=$2 pre i
  local -a rows=()
  mapfile -t rows <<<"$sig"
  local last=$(( ${#rows[@]} - 1 ))
  for i in "${!rows[@]}"; do
    if [[ $i -eq 0 ]]; then pre="  ${rows[i]}"; else pre="        ${rows[i]}"; fi
    if [[ $i -eq $last && -n "$sum" ]]; then
      printf '%-51s %s\n' "$pre" "$sum"
    else
      printf '%s\n' "$pre"
    fi
  done
}

# verb_rows [VERB]: every row, or only the rows that document VERB.
verb_rows() {
  local want=${1:-} i
  for ((i = 0; i < ${#VERB_TABLE[@]}; i += VERB_FIELDS)); do
    # The verb is DATA. As a case pattern it was glob text, so `omabackup '*'
    # --help` matched every row; inside [[ ]] the quoted side is a literal and
    # only the bare wildcards are pattern.
    if [[ -n "$want" ]] && [[ " ${VERB_TABLE[i]} " != *" $want "* ]]; then continue; fi
    verb_row "${VERB_TABLE[i+1]}" "${VERB_TABLE[i+2]}"
  done
}

# verb_known VERB: 0 when the table documents this verb.
verb_known() {
  local i
  for ((i = 0; i < ${#VERB_TABLE[@]}; i += VERB_FIELDS)); do
    # Quoted left side, so the verb is a literal and not a glob: as a case
    # pattern, `omabackup '*' --help` matched every row and exited 0.
    if [[ " ${VERB_TABLE[i]} " == *" $1 "* ]]; then return 0; fi
  done
  return 1
}

# verb_load_mode VERB: the load field of the first row documenting VERB (the
# three setup rows all say the same thing). Returns 1, printing nothing, when
# no row documents it -- callers ask only after verb_known has said yes.
verb_load_mode() {
  local i
  for ((i = 0; i < ${#VERB_TABLE[@]}; i += VERB_FIELDS)); do
    if [[ " ${VERB_TABLE[i]} " == *" $1 "* ]]; then printf '%s\n' "${VERB_TABLE[i+3]}"; return 0; fi
  done
  return 1
}

usage() {
  printf 'omabackup <verb> [args] [--json]\n\n'
  verb_rows
  printf '%s\n' "$VERB_FOOTER"
}

# verb_help VERB: that verb's rows, plus the footer every verb shares. What
# `omabackup <verb> --help` prints.
verb_help() {
  local t
  t=$(verb_rows "$1"; printf '%s\n' "$VERB_FOOTER")
  if [[ $JSON == 1 ]]; then jq -cn --arg u "$t" '{ok:true, usage:$u}'; else printf '%s\n' "$t"; fi
}

main() {
  local verb=${ARGS[0]:-help}
  [[ ${#ARGS[@]} -gt 0 ]] && ARGS=("${ARGS[@]:1}")
  # --help (or -h) right after the verb is answered here, before config_load
  # and before any lib/ parser can see it. restore, lint, snapshot, self-test,
  # setup and open used to call it an unknown flag, and drift, status and
  # health ran the whole verb instead of explaining themselves. The FIRST
  # argument only: `omabackup ignore PATH --help` still records the reason a
  # user typed rather than printing help at them.
  if [[ ${#ARGS[@]} -gt 0 && ( "${ARGS[0]}" == --help || "${ARGS[0]}" == -h ) ]] && verb_known "$verb"; then
    verb_help "$verb"
    return 0
  fi
  case "$verb" in
    help|-h|--help|version|setup) ;;
    # status and health must still report SOMETHING with no config at all --
    # the dispatcher skips config_load for them here and cmd_status/cmd_health
    # never run in that case; a not-configured object/hint is emitted below.
    status)
      if config_exists; then
        config_load status
      else
        # status.json is the widget's only view of the world -- write it here
        # too, or a stale "healthy" file from a previous config survives a
        # config being removed and the widget never learns.
        local j; j=$(health_not_configured_json)
        state_write_status "$j"
        if [[ $JSON == 1 ]]; then
          printf '%s\n' "$j"
        else
          printf '\033[1;33m[omabackup] not configured -- run: omabackup setup\033[0m\n'
        fi
        return 0
      fi ;;
    health)
      if config_exists; then
        config_load
      else
        # Same shared object status uses, so the two never drift apart, with
        # ok:false in front of it: --json must get one JSON object here too,
        # not a coloured line it cannot parse.
        local hj; hj=$(health_not_configured_json)
        if [[ $JSON == 1 ]]; then
          jq -c '{ok:false} + . + {problems: (.problems + ["not configured; run: omabackup setup"])}' <<<"$hj"
        else
          printf '\033[1;31m[omabackup] not configured -- run: omabackup setup\033[0m\n'
        fi
        exit 1
      fi ;;
    # notify-failure is the unit's OnFailure= hook: the one verb whose whole
    # job is to speak up when something else has already gone wrong. A missing
    # or unparsable config is exactly such a failure, and requiring config_load
    # here meant the broken config silenced the notification about itself --
    # the snapshot unit failed, its ExecStopPost died on the same config, and
    # the user's only signal was a red line in a journal nobody reads.
    # So: read the config best-effort, for the one value notify() consults.
    # config_load die()s, and die exits the process rather than returning, so
    # it runs in a subshell and only its answer is carried back. notify()
    # already defaults CFG_NOTIFY to true, which is the fail-loud direction.
    notify-failure)
      if config_exists; then
        local nv; nv=$( (config_load >/dev/null 2>&1 && printf '%s' "${CFG_NOTIFY:-true}") || true )
        if [[ "$nv" == false ]]; then CFG_NOTIFY=false; fi
      fi ;;
    # Everything else the table knows about, and the table's load field decides.
    # A `plain` verb is passed through: config_load validates the same way for
    # all of them and uses the verb only to decide whether a notice about the
    # allowlist floor is worth printing to a caller who did not ask about the
    # floor. A `none` verb runs without a config and a `special` one reports
    # something of its own when there is none, which is why both kinds are
    # named in the arms above rather than derived here.
    *)
      verb_known "$verb" || usage_die "unknown verb '$verb'"
      if [[ $(verb_load_mode "$verb") == plain ]]; then config_load "$verb"; fi ;;
  esac
  case "$verb" in
    help|-h|--help) if [[ $JSON == 1 ]]; then jq -cn --arg u "$(usage)" '{ok:true, usage:$u}'; else usage; fi ;;
    version) if [[ $JSON == 1 ]]; then jq -cn --arg v "$VERSION" '{version:$v}'; else echo "$VERSION"; fi ;;
    # Every other verb the table documents, plus the one it deliberately does
    # not: cmd_<verb>, with the dashes that cannot be in a function name turned
    # into underscores.
    *)
      verb_known "$verb" || [[ $verb == notify-failure ]] || usage_die "unknown verb '$verb'"
      local fn="cmd_${verb//-/_}"
      declare -F "$fn" >/dev/null || die "verb '$verb' is not implemented yet"
      "$fn" "${ARGS[@]}" ;;
  esac
}
main
